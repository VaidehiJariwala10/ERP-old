APP_NAME="Inventory ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Base URL for CSS, JS, and uploads (must end with /). On server use your domain + /public/
ImagePath=http://127.0.0.1:8000/

# --- Production (erp-demo.Inventorytech.com example) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://erp-demo.Inventory.com
# ImagePath=https://erp-demo.Inventorytech.com/public/
# After changing .env on server run: php artisan config:clear && php artisan config:cache

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventory_and_billing
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Biometric Device (Realtime T304-Mini)
BIOMETRIC_DEVICE_NAME=T304-Mini
BIOMETRIC_IP=192.168.1.8
BIOMETRIC_PORT=4370
BIOMETRIC_ALT_PORT=5005
BIOMETRIC_SERIAL=RSS202512133640
BIOMETRIC_PASSWORD=0
BIOMETRIC_CONNECTION=LAN
BIOMETRIC_PUSH_ENABLED=true
BIOMETRIC_SYNC_ENABLED=true
BIOMETRIC_PUBLIC_REFRESH=30
BIOMETRIC_TIMEZONE=Asia/Kolkata

# Realtime Attendance Tracker — Parallel Database Export
BIOMETRIC_REALTIME_EXPORT_ENABLED=true
BIOMETRIC_REALTIME_TABLE=AttendanceLogs
BIOMETRIC_REALTIME_AUTO_IMPORT=true
BIOMETRIC_TEST_KEY=korvia-test-2026

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ---------------------------------------------------------------------------
# License — settings only (NOT purchase codes)
#
# Purchase codes are registered in the license server database via:

#
# After a buyer activates at /license, the signed token is stored in:
#   storage/app/.license/payload.enc  (encrypted, per install — not in .env)
# ---------------------------------------------------------------------------



# License server admin is in the separate Inventory-license project (not this ERP .env).
